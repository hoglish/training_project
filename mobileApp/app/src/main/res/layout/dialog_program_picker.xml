<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="Цель"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spProgramGoal"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Где тренируетесь"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlaceGym"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Зал"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlaceHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дом"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlaceOutdoor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Улица"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Инвентарь"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgProgramInventory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProgInv0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Штанга"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProgInv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Гантели"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProgInv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Турник"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProgInv3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Коврик"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProgInv4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Скакалка"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Дней в неделю"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checkable="true" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvProgramWeather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBuildProgram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Подобрать" />

</LinearLayout>
