<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorkoutDetailActivity"
    android:id="@+id/main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivAnimation"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="Анимация упражнения"
            app:srcCompat="@drawable/gym" />

        <TextView
            android:id="@+id/tvAnimationNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Анимация не загружена"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Жим лёжа"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Тип"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDetailType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="базовое" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Мышцы"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDetailMuscles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Грудь, Трицепс" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Инвентарь"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDetailInventory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Штанга" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgDetailTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDetailOutdoorWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="Уличное упражнение: проверьте погоду"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartWithWorkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Начать с этого упражнения" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToTemplate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить в шаблон"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditWorkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Изменить"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>
