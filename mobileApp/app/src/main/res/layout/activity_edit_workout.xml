<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditWorkoutActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название (до 50 символов, уникальное)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWorkoutName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Тип тренировки"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spWorkoutType"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Мышцы"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgEditMuscles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Грудь"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Спина"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ноги"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Плечи"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Бицепс"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Трицепс"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Кор"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ягодицы"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditMuscle8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Всё тело"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Инвентарь"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgEditInventory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditInv0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Штанга"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditInv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Гантели"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditInv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Турник"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditInv3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Коврик"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditInv4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Скакалка"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditInv5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тренажёр"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditInv6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Гиря"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Теги"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgEditTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditTag0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Силовая"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditTag1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Дом"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditTag2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Зал"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditTag3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Улица"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditTag4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Новичок"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditTag5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Кардио"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEditTag6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Растяжка"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checkable="true" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Анимация (ссылка)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAnimationUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEditError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:textColor="?attr/colorError"
            android:text=""
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveWorkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Сохранить" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteWorkout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Удалить"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</ScrollView>
